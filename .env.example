# Copy to .env and fill in. Real environment variables override this file.

# Where the cogitator itself listens. 127.0.0.1 is right when a reverse proxy
# (Tailscale serve, Caddy, nginx, Traefik, ...) on the same host provides HTTPS.
# Use 0.0.0.0 only if the proxy runs on another machine.
HOST=127.0.0.1
PORT=8080

# Your agentic harness: the base URL of its OpenAI-compatible API
# (the part before /v1/chat/completions). Examples:
#   Hermes Agent API server   http://127.0.0.1:8642
#   Ollama                    http://127.0.0.1:11434
#   LM Studio                 http://127.0.0.1:1234
#   vLLM / llama.cpp server   http://127.0.0.1:8000
AGENT_URL=http://127.0.0.1:8642

# Bearer token the harness expects, if any (e.g. Hermes' API_SERVER_KEY).
AGENT_API_KEY=

# Model name sent with each request. Leave empty to use the first model the
# harness lists on /v1/models.
AGENT_MODEL=

# Optional second lock: a passphrase each device must enter once before it can
# command the agent. Strongly recommended if your harness can run tools.
COGITATOR_ACCESS_CODE=

# Push notifications ("summonings"). They need the app served over HTTPS.
# Where push keys and device subscriptions are kept (created automatically).
# DATA_DIR=data
# Contact URL or mailto: sent to push services (Apple, Google, Mozilla).
# VAPID_SUBJECT=https://github.com/dsmith111/Local-Machine-Spirit-UI

# Images the agent sends as "MEDIA:/path" are shown from these folders only
# (colon-separated; only image files are served). Hermes saves to ~/.hermes.
# MEDIA_DIRS=~/.hermes:/tmp
