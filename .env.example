# Copy to .env and fill in.  (Real environment variables override this file.)

# Where the cogitator itself listens. Keep 127.0.0.1 and expose it with
# `tailscale serve` (gives you HTTPS, which the PWA install needs).
HOST=127.0.0.1
PORT=8080

# The Hermes Agent API server (API_SERVER_* in ~/.hermes/.env on the Pi).
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=paste-the-same-value-as-API_SERVER_KEY

# Model name sent to Hermes. Defaults to hermes-agent (or your profile name).
# HERMES_MODEL=hermes-agent

# Optional second lock: a passphrase the phone must enter once before it can
# command the agent. Recommended, since Hermes can run terminal commands.
COGITATOR_ACCESS_CODE=
