# systemd unit for the cogitator. Adjust User and WorkingDirectory, then:
#   sudo cp deploy/machine-spirit-ui.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now machine-spirit-ui
[Unit]
Description=Cogitator - Machine Spirit PWA for Hermes Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Local-Machine-Spirit-UI
ExecStart=/usr/bin/env node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
